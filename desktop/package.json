{
  "name": "ai-me-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build:shell && node scripts/launch.mjs --dev",
    "build:shell": "tsc -p tsconfig.json && node scripts/verify-shell-build.mjs",
    "build": "npm --prefix ../frontend run build && npm run build:shell",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:chrome": "node scripts/verify-window-chrome.mjs",
    "test:local-models": "node scripts/verify-local-models.mjs",
    "test:project-skills": "node scripts/verify-project-skills.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:browser-host": "node src/browser/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^39.8.7",
    "typescript": "~5.8.3",
    "wait-on": "^9.1.0"
  }
}
